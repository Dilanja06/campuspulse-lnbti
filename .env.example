# Supabase Client Configuration
# The Anon key is public/safe for browser client-side use with Row Level Security (RLS) enabled.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Security Mode: Keep false in production deployments so Supabase Auth enforces strict password verification.
# Set to true only in local development/sandbox demos where quick role buttons are desired.
VITE_DEMO_MODE=false

# IMPORTANT SECURITY NOTE:
# Never put direct database connection strings with postgres passwords in frontend .env files.
